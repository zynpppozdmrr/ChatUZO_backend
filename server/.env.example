# Server Configuration
PORT=3000

# Database - Neon PostgreSQL
# Get this from Neon Dashboard > Connection Details > Pooled Connection (recommended)
DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/dbname?sslmode=require"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"

# CORS Configuration
CLIENT_ORIGIN="http://localhost:5173"

# Railway Production Example:
# DATABASE_URL="postgresql://username:password@ep-xxx.neon.tech/chatuzo?sslmode=require"
# JWT_SECRET="production-secret-key-min-32-chars"
# CLIENT_ORIGIN="https://your-frontend.vercel.app"
