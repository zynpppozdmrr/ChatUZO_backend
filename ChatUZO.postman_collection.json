						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"username\": \"testuser\",\n  \"password\": \"Test1234\",\n  \"birthdate\": \"2000-01-01\",\n  \"avatarUrl\": \"https://i.pravatar.cc/150?img=1\"\n}"
